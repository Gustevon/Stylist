rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);

      match /{collection}/{document=**} {
        allow read, write: if owns(uid);
      }
    }

    match /community_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.likes == [];
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.likes is list &&
          resource.data.likes is list &&
          (
            (request.resource.data.likes.size() == resource.data.likes.size() + 1 &&
              request.auth.uid in request.resource.data.likes &&
              !(request.auth.uid in resource.data.likes) &&
              request.resource.data.likes.hasAll(resource.data.likes)) ||
            (resource.data.likes.size() == request.resource.data.likes.size() + 1 &&
              request.auth.uid in resource.data.likes &&
              !(request.auth.uid in request.resource.data.likes) &&
              resource.data.likes.hasAll(request.resource.data.likes))
          )
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'lastCommentId']) &&
          request.resource.data.commentsCount == resource.data.commentsCount + 1 &&
          request.resource.data.lastCommentId is string &&
          !exists(/databases/$(database)/documents/community_posts/$(postId)/comments/$(request.resource.data.lastCommentId)) &&
          existsAfter(/databases/$(database)/documents/community_posts/$(postId)/comments/$(request.resource.data.lastCommentId))
        )
      );

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 240;
        allow update, delete: if false;
      }
    }
  }
}
