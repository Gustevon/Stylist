rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);

      match /{collection}/{document=**} {
        allow read, write: if owns(uid);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.likes is list &&
          resource.data.likes is list &&
          (
            (request.resource.data.likes.size() == resource.data.likes.size() + 1 &&
              request.auth.uid in request.resource.data.likes &&
              !(request.auth.uid in resource.data.likes) &&
              request.resource.data.likes.hasAll(resource.data.likes)) ||
            (resource.data.likes.size() == request.resource.data.likes.size() + 1 &&
              request.auth.uid in resource.data.likes &&
              !(request.auth.uid in request.resource.data.likes) &&
              resource.data.likes.hasAll(request.resource.data.likes))
          )
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) &&
          request.resource.data.commentsCount == resource.data.commentsCount + 1
        )
      );

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
